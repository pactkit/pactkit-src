{
  "agent_models": {
    "code-explorer": "haiku",
    "product-designer": "opus",
    "system-architect": "opus",
    "system-medic": "haiku"
  },
  "agents": [
    "code-explorer",
    "product-designer",
    "qa-engineer",
    "repo-maintainer",
    "security-auditor",
    "senior-developer",
    "system-architect",
    "system-medic",
    "visual-architect"
  ],
  "auto_fix": false,
  "check": {
    "observe": {
      "enabled": false,
      "max_console": 100,
      "max_network": 200,
      "sources": "auto"
    },
    "pactguard": {
      "blocking": false,
      "enabled": false,
      "mode": "all",
      "ruleset": ""
    },
    "security_checklist": true,
    "security_scope_override": "none"
  },
  "ci": {
    "install_cmd": "python -m pip install --upgrade pip\n          pip install -e \".[visualize]\"\n          pip install pytest ruff\n          pactkit init",
    "provider": "github"
  },
  "command_models": {
    "project-act": "sonnet",
    "project-check": "sonnet",
    "project-done": "sonnet",
    "project-hotfix": "sonnet",
    "project-init": "sonnet",
    "project-pr": "sonnet",
    "project-release": "sonnet"
  },
  "commands": [
    "project-act",
    "project-check",
    "project-clarify",
    "project-debug",
    "project-design",
    "project-done",
    "project-hotfix",
    "project-init",
    "project-plan",
    "project-pr",
    "project-release",
    "project-sprint"
  ],
  "developer": "slim",
  "done": {
    "lesson_quality_threshold": 15
  },
  "e2e": {
    "api_spec": "",
    "blocking": false,
    "compose_file": "docker-compose.test.yml",
    "env_file": ".env.test",
    "test_dir": "tests/e2e",
    "type": "none"
  },
  "enforcement": {
    "allow_direct_push": false,
    "auth_gate": true,
    "auth_ttl_minutes": 30,
    "protected_branches": [
      "main",
      "master"
    ],
    "secrets_gate": true,
    "spec_guard": true,
    "tamper_guard": true
  },
  "issue_tracker": {
    "provider": "github"
  },
  "lint_blocking": false,
  "regression": {
    "max_impact_tests": 50,
    "strategy": "impact"
  },
  "release": {
    "github_release": true
  },
  "root": ".",
  "rules": [
    "capability-design",
    "engineering-index",
    "external-tools",
    "git-workflow",
    "pdca-lifecycle",
    "phase-act",
    "phase-check",
    "phase-done",
    "phase-hotfix",
    "phase-plan",
    "phase-pr",
    "phase-release",
    "runtime",
    "sectional-heuristics",
    "shared-execution",
    "spec-preflight",
    "sprint-orchestrator"
  ],
  "skills": [
    "pactkit-analyze",
    "pactkit-audit",
    "pactkit-board",
    "pactkit-doctor",
    "pactkit-draw",
    "pactkit-garden",
    "pactkit-release",
    "pactkit-report",
    "pactkit-review",
    "pactkit-scaffold",
    "pactkit-status",
    "pactkit-trace",
    "pactkit-visualize",
    "project-act",
    "project-check",
    "project-clarify",
    "project-debug",
    "project-design",
    "project-done",
    "project-hotfix",
    "project-init",
    "project-plan",
    "project-pr",
    "project-release",
    "project-sprint"
  ],
  "stack": "python",
  "telemetry": {
    "assessment_floor": 0.3,
    "guide_window_days": 30,
    "w012_rate_threshold": 0.5
  },
  "venv": {
    "auto_detect": true
  },
  "visualize": {
    "graph_provider": "codegraph",
    "scan_excludes": [
      "venv",
      "_venv",
      ".venv",
      ".env",
      "env",
      "__pycache__",
      ".git",
      ".claude",
      "tests",
      "docs",
      "node_modules",
      "site-packages",
      "dist",
      "build"
    ]
  }
}
